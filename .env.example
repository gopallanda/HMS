# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
#
# This project targets a HOSTED Supabase project (region: Mumbai, ap-south-1).
# There is no local Docker stack.

# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses RLS for every tenant.
# Never prefix with NEXT_PUBLIC_. Never import outside lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string, used ONLY by scripts/db.mjs to apply migrations
# and run the seed. Not read by the app at runtime.
#
#   Dashboard -> Connect -> Direct connection
#   (Session pooler also works; Transaction pooler does NOT — migrations need
#    a session-level connection for advisory locks.)
#
# Percent-encode special characters in the password: @ -> %40, # -> %23, etc.
# Example:
#   postgresql://postgres:pa%40ss@db.abcdefghijklmno.supabase.co:5432/postgres
SUPABASE_DB_URL=

# Where this deployment lives. Used ONLY to build password reset links.
#
# Server configuration, deliberately: it is never derived from the request's
# Host or X-Forwarded-Host header. An attacker who can set those can make a
# reset link point at their own server, and the victim clicking their own
# genuine email hands over a working token. Optional in development (falls back
# to http://localhost:3000); required in production, where a missing value is a
# hard error rather than a localhost URL in somebody's inbox.
APP_BASE_URL=

# The right-hand side of every synthetic staff login address:
#   pavan.kumar@<hospital-slug>.<this>
#
# Staff sign in with a USERNAME. Supabase Auth identifies users by email, so
# each account gets an address that exists only to satisfy it -- never shown to
# staff, never receiving mail. The default is a .invalid domain (RFC 2606), so
# it can never resolve and a misconfigured mailer can never deliver to one by
# accident. Change it only if you own the domain; changing it AFTER accounts
# exist orphans every login built from the old one.
NEXT_PUBLIC_STAFF_EMAIL_DOMAIN=staff.hms.invalid

# The one email this product sends: a staff password reset.
#
# Optional. Without a key nothing is sent -- in development the link is printed
# to the terminal instead, and the forgot-password screen says the same thing
# either way, because a response that changed would tell an attacker which
# addresses belong to staff. In production a missing key is logged loudly.
RESEND_API_KEY=
MAIL_FROM=

# Personal access token, used ONLY by `npm run db:types`.
#
#   Dashboard -> Account -> Access Tokens -> Generate new token
#
# Type generation goes through the Management API rather than SUPABASE_DB_URL,
# because the CLI serves --db-url out of a Docker container and this project
# has no Docker. Optional: everything except db:types works without it.
SUPABASE_ACCESS_TOKEN=
